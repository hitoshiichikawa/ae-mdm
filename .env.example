# ae-mdm 環境変数テンプレート
# requirements.md Requirement 4 / NFR 1.2
#
# 使い方:
#   cp .env.example .env
#   # 各 placeholder を実値に置き換える
#   # 注意: .env は .gitignore で除外済み。本番認証情報・秘密鍵をコミットしないこと
#
# 値の見方:
#   <REPLACE_ME> ... 実値に置き換えが必要なもの
#   既定値あり    ... 値を空にすると docker-compose.yml 内の default にフォールバック

# =====================================================================
# PostgreSQL 接続情報 (requirements.md 4.2)
# =====================================================================
POSTGRES_USER=ae_mdm
POSTGRES_PASSWORD=<REPLACE_ME_LOCAL_DEV_PASSWORD>
POSTGRES_DB=ae_mdm
POSTGRES_HOST_PORT=5432
# api / worker から見た接続 URL（docker-compose ネットワーク内部）
DATABASE_URL=postgres://ae_mdm:<REPLACE_ME_LOCAL_DEV_PASSWORD>@postgres:5432/ae_mdm?sslmode=disable

# =====================================================================
# OIDC: tenant-console 用クライアント (requirements.md 4.3, NFR 2.1)
# =====================================================================
OIDC_TENANT_ISSUER_URL=http://keycloak:8080/realms/ae-mdm
OIDC_TENANT_CLIENT_ID=tenant-console
OIDC_TENANT_REDIRECT_URL=http://localhost:5173/auth/callback

# =====================================================================
# OIDC: admin-console 用クライアント (requirements.md 4.3, NFR 2.1)
# =====================================================================
OIDC_ADMIN_ISSUER_URL=http://keycloak:8080/realms/ae-mdm
OIDC_ADMIN_CLIENT_ID=admin-console
OIDC_ADMIN_REDIRECT_URL=http://localhost:5174/auth/callback

# Keycloak 管理者初期パスワード（dev realm 用）
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<REPLACE_ME_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_MGMT_HOST_PORT=9000

# =====================================================================
# Cloud Pub/Sub (requirements.md 4.4)
# =====================================================================
PUBSUB_PROJECT_ID=ae-mdm-dev
PUBSUB_TOPIC=amapi-notifications
PUBSUB_SUBSCRIPTION=amapi-notifications-sub
# ローカルで emulator を使う場合に api / worker から参照される。本番では空にする
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
PUBSUB_HOST_PORT=8085

# =====================================================================
# Android Management API (requirements.md 4.5)
# =====================================================================
# サービスアカウント鍵 JSON のパス（コンテナ内のパス）。本番では Secrets Manager 等で注入
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/amapi-sa.json
AMAPI_PROJECT_ID=<REPLACE_ME_GCP_PROJECT_ID>

# =====================================================================
# 管理者セッション暗号化用秘密鍵 (requirements.md 4.6)
# =====================================================================
# 32 バイト以上のランダム値を推奨（例: openssl rand -hex 32）
SESSION_SECRET=<REPLACE_ME_GENERATE_32_BYTES_OF_RANDOM_HEX>

# =====================================================================
# 監査ログ保持期間・端末同期遅延閾値 (requirements.md 4.7 / NFR 3.2, 4.2)
# =====================================================================
# 監査ログを保持する日数（既定 180 日 / NFR 4.2）
AUDIT_LOG_RETENTION_DAYS=180
# 端末の STATUS_REPORT 通知が来ないまま「同期遅延」と判定するまでの時間（既定 24 時間 / NFR 3.2）
DEVICE_SYNC_DELAY_THRESHOLD_HOURS=24

# =====================================================================
# host ポートマッピング上書き（任意）
# =====================================================================
API_HOST_PORT=8080
TENANT_CONSOLE_HOST_PORT=5173
ADMIN_CONSOLE_HOST_PORT=5174
