# ae-mdm 環境変数テンプレート
# requirements.md Requirement 4 / NFR 1.2
#
# 使い方:
#   cp .env.example .env
#   # 各 placeholder を実値に置き換える
#   # 注意: .env は .gitignore で除外済み。本番認証情報・秘密鍵をコミットしないこと
#
# 値の見方:
#   <REPLACE_ME> ... 実値に置き換えが必要なもの
#   既定値あり    ... 値を空にすると docker-compose.yml 内の default にフォールバック
#
# DB ロール分離（Issue #2 / Req 6.5）:
#   DATABASE_URL は app_user（DML 専用、RLS バインド対象、audit_logs UPDATE/DELETE は REVOKE 済）
#   で接続し、MIGRATE_DATABASE_URL は migration_user（DDL 専用）で接続する。両ロールは
#   backend/db/roles/0001_create_app_and_migration_roles.sql で定義され、ホストから
#   `make db-init-roles` で初期セットアップする（golang-migrate の管轄外）。
#   POSTGRES_USER / POSTGRES_PASSWORD は postgres コンテナの superuser として使用し、
#   app_user / migration_user 作成のため `make db-init-roles` 実行時にも必要。

# =====================================================================
# PostgreSQL 接続情報 (requirements.md 4.2)
# =====================================================================
POSTGRES_USER=ae_mdm
POSTGRES_PASSWORD=<REPLACE_ME_LOCAL_DEV_PASSWORD>
POSTGRES_DB=ae_mdm
POSTGRES_HOST_PORT=5432
# api / worker から見た接続 URL（docker-compose ネットワーク内部のホスト名 `postgres`）。
# user は app_user（DML 専用、RLS バインド対象、audit_logs UPDATE/DELETE は REVOKE 済）。
# app_user は backend/db/roles/0001_create_app_and_migration_roles.sql で定義し、
# `make db-init-roles` で初期セットアップする。
DATABASE_URL=postgres://app_user:<REPLACE_ME_APP_PASSWORD>@postgres:5432/ae_mdm?sslmode=disable
# ホストから `make migrate-up` / `make migrate-down` を実行するときに使う URL。
# user は migration_user（DDL 専用）。docker-compose の `postgres` サービスは
# `POSTGRES_HOST_PORT` (既定 5432) で publish 済み。値が未設定の場合 Makefile は
# DATABASE_URL にフォールバックする（compose 内 hostname の `postgres` はホストから
# 解決できないため、ホスト実行ではこちらを利用する）。
# migration_user は backend/db/roles/0001_create_app_and_migration_roles.sql で定義し、
# `make db-init-roles` で初期セットアップする。
MIGRATE_DATABASE_URL=postgres://migration_user:<REPLACE_ME_MIGRATION_PASSWORD>@localhost:5432/ae_mdm?sslmode=disable

# =====================================================================
# OIDC: tenant-console 用クライアント (requirements.md 4.3, NFR 2.1)
# Issue #33: BFF confidential authorization code flow を採用し、IdP からの
# redirect 先は backend の callback handler に向ける（SPA 側 /auth/callback は
# 後続 SPA Issue 範囲）。Keycloak realm 側 client 登録 redirect URI もこの URL と
# 一致させる必要がある。
# =====================================================================
OIDC_TENANT_ISSUER_URL=http://keycloak:8080/realms/ae-mdm
OIDC_TENANT_CLIENT_ID=tenant-console
OIDC_TENANT_REDIRECT_URL=http://localhost:8080/api/auth/callback
OIDC_TENANT_CLIENT_SECRET=<REPLACE_ME_FROM_KEYCLOAK_TENANT_CLIENT>

# =====================================================================
# OIDC: admin-console 用クライアント (requirements.md 4.3, NFR 2.1)
# Issue #33: 同じく backend callback を IdP に登録する。
# =====================================================================
OIDC_ADMIN_ISSUER_URL=http://keycloak:8080/realms/ae-mdm
OIDC_ADMIN_CLIENT_ID=admin-console
OIDC_ADMIN_REDIRECT_URL=http://localhost:8080/api/admin/auth/callback
OIDC_ADMIN_CLIENT_SECRET=<REPLACE_ME_FROM_KEYCLOAK_ADMIN_CLIENT>

# Keycloak 管理者初期パスワード（dev realm 用）
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<REPLACE_ME_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_MGMT_HOST_PORT=9000

# =====================================================================
# Cloud Pub/Sub (requirements.md 4.4)
# =====================================================================
PUBSUB_PROJECT_ID=ae-mdm-dev
PUBSUB_TOPIC=amapi-notifications
PUBSUB_SUBSCRIPTION=amapi-notifications-sub
# 処理不能メッセージの送出先 dead-letter topic（Issue #35 requirements 5.x）。
# emulator モードでは worker が起動時に冪等 ensure する。本番は IaC で事前作成する想定。
PUBSUB_DEAD_LETTER_TOPIC=amapi-notifications-deadletter
# worker が同時に未確定（ack 待ち）で保持するメッセージ数の上限（Issue #35 requirements 4.1）。
# 未設定なら 1000。1 未満を設定すると worker は起動時に fail-fast する（requirements 4.3）。
PUBSUB_MAX_OUTSTANDING_MESSAGES=1000
# ローカルで emulator を使う場合に api / worker から参照される。本番では空にする
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
PUBSUB_HOST_PORT=8085

# =====================================================================
# Android Management API (requirements.md 4.5)
# =====================================================================
# サービスアカウント鍵 JSON のパス（コンテナ内のパス）。本番では Secrets Manager 等で注入
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/amapi-sa.json
AMAPI_PROJECT_ID=<REPLACE_ME_GCP_PROJECT_ID>

# =====================================================================
# 管理者セッション暗号化用秘密鍵 (requirements.md 4.6)
# =====================================================================
# 32 バイト以上のランダム値を推奨（例: openssl rand -hex 32）
SESSION_SECRET=<REPLACE_ME_GENERATE_32_BYTES_OF_RANDOM_HEX>

# =====================================================================
# セッション / state cookie タイムアウト・MAC 鍵 (Issue #33 / Req 2.4 / 4.4 / 4.5 / NFR 2.1)
# =====================================================================
# 管理者セッションのアイドルタイムアウト（既定 30m / 1s..24h）。
SESSION_IDLE_TIMEOUT=30m
# 管理者セッションの絶対有効期限（既定 8h / 1s..24h、IDLE <= ABS 必須）。
SESSION_ABSOLUTE_TIMEOUT=8h
# OIDC 認可コードフローで使う state 保護 cookie の有効期限（既定 10m / 1s..10m）。
STATE_COOKIE_TTL=10m
# state 保護 cookie の HMAC-SHA256 鍵（32 バイト以上 / 例: openssl rand -hex 32）。
STATE_MAC_SECRET=<REPLACE_ME_GENERATE_32_BYTES_OF_RANDOM_HEX>

# =====================================================================
# 監査ログ保持期間・端末同期遅延閾値 (requirements.md 4.7 / NFR 3.2, 4.2)
# =====================================================================
# 監査ログを保持する日数（既定 180 日 / NFR 4.2）
AUDIT_LOG_RETENTION_DAYS=180
# 端末の STATUS_REPORT 通知が来ないまま「同期遅延」と判定するまでの時間（既定 24 時間 / NFR 3.2）
DEVICE_SYNC_DELAY_THRESHOLD_HOURS=24

# =====================================================================
# host ポートマッピング上書き（任意）
# =====================================================================
API_HOST_PORT=8080
TENANT_CONSOLE_HOST_PORT=5173
ADMIN_CONSOLE_HOST_PORT=5174
